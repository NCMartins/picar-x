# PiCar-X Configuration Template
# Generated by Ansible - DO NOT EDIT MANUALLY
#
# WARNING: this template is out of date and deploying it will break the app.
# It predates the robot-hat migration (it still emits per-GPIO motor pins
# instead of MOTOR_LEFT/MOTOR_RIGHT) and is missing every setting added since:
# AUTH_USERNAME/AUTH_PASSWORD, ALLOWED_ORIGINS, the steering and motor-watchdog
# settings, and the whole voice block. backend/app.py imports those by name, so
# a rendered config.py raises ImportError at startup.
#
# Until it's reconciled with config/config.py, prefer deploying the repository's
# own config.py and supplying per-host settings through the environment (see the
# systemd unit template, which does exactly that for the auth and voice keys).

# Hardware Configuration
# Motor pins (BCM numbering)
MOTOR_LEFT_FORWARD = {{ picar_motor_left_forward }}
MOTOR_LEFT_BACKWARD = {{ picar_motor_left_backward }}
MOTOR_RIGHT_FORWARD = {{ picar_motor_right_forward }}
MOTOR_RIGHT_BACKWARD = {{ picar_motor_right_backward }}

# PWM Configuration
PWM_FREQUENCY = 1000  # 1 kHz
MAX_SPEED = {{ picar_max_speed }}  # 0-100%

# Servo Configuration (using PCA9685 or similar)
SERVO_PAN_CHANNEL = {{ picar_servo_pan_channel }}
SERVO_TILT_CHANNEL = {{ picar_servo_tilt_channel }}
SERVO_MIN_ANGLE = -90
SERVO_MAX_ANGLE = 90

# Camera Configuration
CAMERA_RESOLUTION = ({{ picar_camera_resolution_width }}, {{ picar_camera_resolution_height }})
CAMERA_FRAMERATE = {{ picar_camera_framerate }}
CAMERA_ROTATION = 0
STREAM_PORT = 8000
STREAM_QUALITY = 80  # 0-100

# Flask Configuration
FLASK_HOST = '{{ picar_flask_host }}'
FLASK_PORT = {{ picar_flask_port }}
FLASK_DEBUG = False

# Streaming Configuration
MJPEG_BOUNDARY = b'--BOUNDARY'
MJPEG_CONTENT_TYPE = 'multipart/x-mixed-replace; boundary=--BOUNDARY'